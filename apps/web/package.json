    "perf:psi:baseline": "node scripts/pagespeed-guardrail.mjs --write-baseline",
    "perf:robots:check": "node scripts/validate-robots-output.mjs",
    "rum:weekly": "node scripts/fetch-rum-weekly-report.mjs",
    "smoke:dashboard": "node scripts/dashboard-stability-smoke.mjs"
  },
  "dependencies": {
    "@gp/types": "0.1.0",
    "@gp/ui": "0.1.0",
    "@tiptap/extension-highlight": "3.20.4",
