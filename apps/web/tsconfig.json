{
  "extends": "../../packages/config-ts/next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@dashboard/*": ["./features/dashboard/*"],
      "@gp/types": ["../../packages/types/src"],
      "@gp/ui": ["../../packages/ui/src"]
    },
    "types": ["vitest/globals", "node"],
    "allowJs": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
