# Web app listens on port 30001 by default (see package.json dev/start scripts)
PORT=30001
NEXTAUTH_URL=http://localhost:30001
NEXTAUTH_SECRET=replace-with-a-long-random-secret
SITE_CONFIG_ENV=development
AUTH_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

NEXT_PUBLIC_RAZORPAY_KEY_ID=replace-with-razorpay-key-id
