{
  "name": "@gemini-prompts/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma",
    "db:check": "ts-node --project tsconfig.json prisma/check-db.ts",
    "db:migrate:dashboard": "ts-node --project tsconfig.json prisma/apply-dashboard-migration.ts",
    "db:migrate:all": "ts-node --project tsconfig.json prisma/apply-sql-migrations.ts"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "11.2.6",
    "@prisma/client": "^6.5.0",
    "bullmq": "5.71.0",
    "cache-manager": "7.2.8",
    "cache-manager-redis-store": "3.0.1",
    "cache-manager-redis-yet": "5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@types/express": "5.0.6",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
